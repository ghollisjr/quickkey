# quickkey, kept warm so the hotkey opens in ~20ms instead of ~60ms.
#
#   systemctl --user enable --now quickkey.service
#
# This is a *user* unit: it runs as you, inside your graphical session, and
# must not be enabled with a plain `systemctl enable`.

[Unit]
Description=quickkey clipboard command menu
Documentation=https://github.com/ghollisjr/quickkey
# the daemon builds a window at startup, so it needs a display to exist.
# This is ordering only -- plenty of X sessions never activate the target.
After=graphical-session.target
PartOf=graphical-session.target
# The user manager comes up at login, which on a startx session is minutes
# before X exists, and a daemon with no $DISPLAY exits 1.  Retrying is the
# only way back: a service's environment is captured when it starts, so the
# DISPLAY that /etc/X11/xinit/xinitrc.d/50-systemd-user.sh imports into the
# manager reaches this unit on its NEXT start and not before.  120 tries
# 5s apart keeps that door open for ten minutes, then gives up so a headless
# login does not respawn forever.
StartLimitIntervalSec=600
StartLimitBurst=120

[Service]
Type=simple
ExecStart=/usr/bin/quickkey --daemon
# Ctrl-Q in the window is a deliberate quit and exits 0; only crashes restart.
Restart=on-failure
RestartSec=5s

[Install]
# NOT graphical-session.target: many X sessions (startx, bare window
# managers, display managers that do not reach it) leave that target
# inactive, and the service would then never start.  default.target is
# reached whenever your user manager comes up at login.
WantedBy=default.target
